# API Nest (opcional — /vista funciona sin backend; upload de álbum requiere API)
# En dev, vacío = mismo origen + proxy Vite → localhost:3400
# API_BASE_URL=
# En prod (Vercel + API desplegada):
# API_BASE_URL=https://tu-api.ejemplo.com
# (También lo usa /api/invite-preview para el título «Nombre · Invitación…» en WhatsApp.)
# El bucket S3 del álbum se configura en casamiento-vanesa-augusto/api/.env (ALBUM_S3_BUCKET)
# Opcional en dev: misma URL que INVITE_PUBLIC_BASE_URL del backend (copiar link sin localhost)
# VITE_INVITE_PUBLIC_BASE_URL=https://casamiento-vanesa-augusto.vercel.app
